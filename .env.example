# Copy to .env.local (development) or set in your host's environment (production).
# Nothing here is required for local development: with no DATABASE_URL an embedded Postgres
# (./data/pglite) is created, migrated and filled with sample content automatically.

# ---------------------------------------------------------------- app
# Public URL of the app (used in emails and payment return links).
APP_URL=http://localhost:3000
# Time zone for dashboard analytics (time slots, daily revenue).
APP_TZ=Africa/Johannesburg

# ---------------------------------------------------------------- database
# Any Postgres 14+ (Supabase, Neon, RDS...). Required in production.
# DATABASE_URL=postgres://user:password@host:5432/auxed
# DATABASE_SSL=true              # set to false for a local Postgres without TLS
# DATABASE_POOL_MAX=10
# AUXED_AUTO_MIGRATE=false       # true = run migrations on boot (otherwise `npm run db:migrate` in your deploy)
# Sample content (demo venues, sets, accounts) — on by default in development, off in production.
# AUXED_SAMPLE_DATA=false
# AUXED_PGLITE_DIR=./data/pglite # embedded dev database location

# ---------------------------------------------------------------- payments (token wallet top-ups)
# paystack | stripe. In development, leaving this unset uses an instant test credit (no real payment).
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_live_...      # webhook URL: {APP_URL}/api/webhooks/paystack
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # webhook URL: {APP_URL}/api/webhooks/stripe (checkout.session.completed)

# ---------------------------------------------------------------- email
# Verification and password-reset emails via Resend. Without a key they are printed to the server log.
# RESEND_API_KEY=re_...
# MAIL_FROM=AUXED <no-reply@yourdomain.com>

# ---------------------------------------------------------------- sign in with Google / Apple (optional)
# Redirect URIs: {APP_URL}/api/auth/oauth/google/callback and {APP_URL}/api/auth/oauth/apple/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=                     # Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------- music connections & auto-queue
# Spotify app (developer.spotify.com). Redirect URI: {APP_URL}/api/music/connect/spotify/callback
# Also used for song search when set. Note: new apps are limited to 25 users until Spotify approves them.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Apple Music (MusicKit key from developer.apple.com) — Apple Music sign-in, favourites import and the AUXED Player.
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# YouTube Data API key — lets the AUXED Player find songs on YouTube.
# YOUTUBE_API_KEY=

# ---------------------------------------------------------------- notifications (lock-screen card)
# Web push keys: generate with `npx web-push generate-vapid-keys` (development makes its own in ./data).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com
# Native iOS Live Activities (see native/README.md)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=app.auxed
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# APNS_PRODUCTION=false

# ---------------------------------------------------------------- AUX IN (live audio)
# STUN is built in; add a TURN server so listeners on strict mobile networks can connect.
# TURN_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------------------------------------------- music search
# Free iTunes Search API by default (no key). Storefront country for results:
MUSIC_COUNTRY=ZA

# ---------------------------------------------------------------- map
# A dark map style from your tile provider (MapTiler, Stadia, Mapbox...) for production.
# Without it, OpenStreetMap tiles are darkened in CSS (fine for development/light use only).
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
